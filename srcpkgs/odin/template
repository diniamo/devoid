pkgname=odin
version=2026.06
revision=1
_llvm_version=21
build_style=gnu-makefile
make_build_target=release
hostmakedepends="llvm$_llvm_version clang$_llvm_version"
makedepends="llvm$_llvm_version-devel"
depends="clang$_llvm_version lld$_llvm_version"
short_desc="Data-Oriented Language for Sane Software Development"
maintainer="diniamo <diniamo53@proton.me>"
license="Zlib"
homepage="https://odin-lang.org/"
distfiles="https://github.com/odin-lang/Odin/archive/refs/tags/dev-${version//./-}.tar.gz"
checksum=9f91df15e06e782bdd2825926efc256ad1a79b3e022a1398e4e10dcc4d4d95fa
nostrip=yes
noshlibprovides=yes
noverifyrdeps=yes

pre_build() {
	export CXX=/usr/bin/clang++
}

post_build() {
	make -C vendor/stb/src
	make -C vendor/cgltf/src
	make -C vendor/miniaudio/src
}

do_install() {
	vmkdir opt/$pkgname
	cp -a odin base core shared vendor $DESTDIR/opt/$pkgname

	vmkdir usr/bin
	ln -s /opt/odin/odin $DESTDIR/usr/bin

	vdoc README.md
	vlicense LICENSE
}
